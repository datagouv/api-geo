{
  "name": "@etalab/api-geo",
  "version": "2.5.3",
  "description": "Interroger les référentiels géographiques plus facilement",
  "repository": {
    "type": "git",
    "url": "git://github.com/etalab/api-geo.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sentry/node": "^7.37.2",
    "@sentry/tracing": "^7.37.2",
    "@turf/bbox": "^6.5.0",
    "@turf/bbox-polygon": "^6.5.0",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "lodash": "^4.17.11",
    "lunr": "1.0.0",
    "morgan": "^1.9.1",
    "rbush": "^2.0.1"
  },
  "devDependencies": {
    "@etalab/decoupage-administratif": "6.1.0",
    "@turf/area": "^6.0.1",
    "@turf/point-on-feature": "^6.0.2",
    "@turf/truncate": "^6.0.1",
    "benchmark": "^2.1.0",
    "debug": "^4.1.1",
    "expect.js": "^0.3.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "supertest": "^7.3.2",
    "xo": "^5.0.1"
  },
  "resolutions": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9",
    "katex": "^0.19.1"
  },
  "scripts": {
    "bench": "DEBUG=store,bench node bench",
    "lint": "xo",
    "start": "node --max_old_space_size=2048 server",
    "test": "NODE_OPTIONS=--max_old_space_size=2048 nyc mocha --exit --timeout 5000",
    "download-sources": "./download-sources.sh",
    "build-only": "node --max_old_space_size=4096 build",
    "build": "yarn download-sources && yarn build-only",
    "generate-api-infos": "node generate-infos.js"
  },
  "engines": {
    "node": ">= 10"
  },
  "contributors": [
    "Jérôme Desboeufs <jerome.desboeufs@data.gouv.fr>",
    "Théophile Merlière <theophile.merliere@data.gouv.fr>",
    "Thomas Gratier <thomas.gratier@data.gouv.fr>"
  ],
  "license": "MIT",
  "xo": [
    {
      "ignores": [
        "test/*.js",
        "**/*.json",
        "**/*.md"
      ]
    },
    {
      "semicolon": false,
      "space": 2,
      "rules": {
        "n/no-path-concat": "off",
        "unicorn/filename-case": "off",
        "import-x/order": "off",
        "import-x/extensions": "off",
        "no-return-assign": "off",
        "@eslint-community/eslint-comments/require-description": "off",
        "n/prefer-global/process": "off",
        "no-unused-vars": "off",
        "regexp/no-useless-flag": "off",
        "regexp/prefer-named-capture-group": "off",
        "require-unicode-regexp": "off",
        "unicorn/consistent-boolean-name": "off",
        "unicorn/consistent-json-file-read": "off",
        "unicorn/import-style": "off",
        "unicorn/logical-assignment-operators": "off",
        "unicorn/name-replacements": "off",
        "unicorn/no-array-callback-reference": "off",
        "unicorn/no-array-method-this-argument": "off",
        "unicorn/no-array-reduce": "off",
        "unicorn/no-array-sort": "off",
        "unicorn/no-computed-property-existence-check": "off",
        "unicorn/no-for-each": "off",
        "unicorn/no-for-loop": "off",
        "unicorn/no-immediate-mutation": "off",
        "unicorn/no-lonely-if": "off",
        "unicorn/no-undeclared-class-members": "off",
        "unicorn/prefer-early-return": "off",
        "unicorn/prefer-logical-operator-over-ternary": "off",
        "unicorn/prefer-module": "off",
        "unicorn/prefer-number-coercion": "off",
        "unicorn/prefer-number-is-safe-integer": "off",
        "unicorn/prefer-number-properties": "off",
        "unicorn/prefer-set-has": "off",
        "unicorn/prefer-string-replace-all": "off",
        "unicorn/prefer-string-slice": "off",
        "unicorn/prefer-ternary": "off",
        "unicorn/prefer-top-level-await": "off",
        "unicorn/require-array-sort-compare": "off"
      }
    }
  ]
}
